{
  "name": "react-native-poc",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "security:check": "! (rg 'rpc\\([\"\\x27]get_user_(app_state|onboarding_status)[\"\\x27].*\\{.*user_id' src --type js || rg 'rpc\\([\"\\x27]complete_workout[\"\\x27].*\\{.*_user_id' src --type js)"
  },
